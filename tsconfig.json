{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "mocha"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "esbuild.js",
    "vitest.config.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test/integration/fixtures",
    "test/integration/out"
  ]
}
